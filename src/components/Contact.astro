  {
    name: 'WhatsApp',
    href: whatsappUrl(),
    external: true,
    path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
  },
  {
    name: 'Mail',
    href: `mailto:${site.email}`,
    external: false,
    path: 'M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z',
  },
  {
    name: 'LinkedIn',
    href: site.linkedin,
    external: true,
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];
---

<section id="contacto" class="relative isolate scroll-mt-16 overflow-hidden bg-night-2 pt-28 pb-24 md:pt-40 md:pb-32">
  <div
    class="pointer-events-none absolute -bottom-1/3 left-1/2 -z-10 size-[60rem] -translate-x-1/2 rounded-full"
    style="background: radial-gradient(closest-side, rgb(255 91 31 / .13), transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="flex flex-col items-center text-center">
      <p class="label mb-10" data-reveal>Contacto</p>
      <div>
        <h2 class="display text-[clamp(3.4rem,11vw,9.5rem)]" data-split>
          Hablemos<span class="text-neon">.</span>
        </h2>
        <p class="mx-auto mt-8 max-w-lg text-lg leading-relaxed text-dim" data-reveal>
          Contame de tu negocio y te digo cómo podría quedar tu página. La primera charla y la maqueta no cuestan
          nada.
        </p>

        <ul class="mt-14 flex flex-wrap justify-center gap-4 sm:gap-6" data-stagger>
          {
            links.map((l) => (
              <li data-stagger-item>
                <a
                  href={l.href}
                  {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                  class="contact-logo"
                  aria-label={l.name}
                  title={l.name}
                  data-magnetic
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={l.path} />
                  </svg>
                  <span class="label">{l.name}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <button type="button" class="label mx-auto mt-8 block hover:!text-bone" data-copy={site.email} data-reveal>
          Copiar mail · {site.email}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    width: 7.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-rule);
    border-radius: 1.75rem;
    background: rgb(242 238 232 / 0.03);
    color: var(--color-bone);
    transition:
      background-color 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo),
      color 0.4s var(--ease-out-expo);
  }
  .contact-logo svg {
    width: 2.4rem;
    height: 2.4rem;
  }
  .contact-logo .label {
    transition: color 0.4s var(--ease-out-expo);
  }
  .contact-logo:hover {
    background: var(--color-neon);
    border-color: var(--color-neon);
    color: var(--color-night);
  }
  .contact-logo:hover .label {
    color: var(--color-night);
  }
  @media (max-width: 400px) {
    .contact-logo {
      width: 6.25rem;
      border-radius: 1.4rem;
    }
    .contact-logo svg {
      width: 2rem;
      height: 2rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Mail copiado ✓';
      } catch {
        btn.textContent = 'No se pudo copiar';
      }
      setTimeout(() => (btn.textContent = original), 1800);
    });
  });
</script>
