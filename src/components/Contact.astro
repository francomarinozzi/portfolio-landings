---
import { site, whatsappUrl } from '../data/site';

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<section id="contacto" class="relative isolate scroll-mt-16 overflow-hidden bg-night-2 pt-28 pb-16 md:pt-40">
  <div
    class="pointer-events-none absolute -bottom-1/3 left-1/2 -z-10 size-[60rem] -translate-x-1/2 rounded-full"
    style="background: radial-gradient(closest-side, rgb(255 91 31 / .13), transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid gap-10 lg:grid-cols-[14rem_1fr]">
      <p class="label" data-reveal>Contacto</p>
      <div>
        <h2 class="display text-[clamp(3.4rem,11vw,9.5rem)]" data-split>
          Hablemos<span class="text-neon">.</span>
        </h2>
        <p class="mt-8 max-w-lg text-lg leading-relaxed text-dim" data-reveal>
          Contame de tu negocio y te digo cómo podría quedar tu página. La primera charla y la maqueta no cuestan
          nada.
        </p>

        <div class="mt-14 grid gap-16 lg:grid-cols-2">
          <div class="flex flex-col" data-reveal>
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener"
              class="group rule flex items-center justify-between gap-4 border-t py-6"
            >
              <span>
                <span class="label block">WhatsApp · lo más rápido</span>
                <span class="mt-1 block text-2xl font-medium tracking-tight md:text-3xl">{site.whatsappDisplay}</span>
              </span>
              <span class="text-2xl text-neon transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>
            <div class="rule flex items-center justify-between gap-4 border-y py-6">
              <a href={`mailto:${site.email}`} class="min-w-0">
                <span class="label block">Mail</span>
                <span class="ulink mt-1 block truncate text-xl font-medium tracking-tight md:text-2xl">{site.email}</span>
              </a>
              <button type="button" class="label shrink-0 !text-bone hover:!text-neon" data-copy={site.email}>
                Copiar
              </button>
            </div>
          </div>

          <form class="flex flex-col gap-1" data-contact-form data-key={web3formsKey} data-email={site.email} data-reveal>
            <p class="label mb-4">O dejame un mensaje</p>
            <label class="field-wrap">
              <span class="label">Nombre</span>
              <input name="nombre" required autocomplete="name" class="field" />
            </label>
            <label class="field-wrap">
              <span class="label">Negocio</span>
              <input name="negocio" class="field" placeholder="Opcional" />
            </label>
            <label class="field-wrap">
              <span class="label">Mail o teléfono</span>
              <input name="contacto" required class="field" />
            </label>
            <label class="field-wrap">
              <span class="label">Mensaje</span>
              <textarea name="mensaje" rows="3" required class="field resize-none"></textarea>
            </label>
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
            <div class="mt-6 flex flex-wrap items-center gap-5">
              <button type="submit" class="btn btn-neon" data-submit>Enviar ↗</button>
              <p class="text-sm" role="status" aria-live="polite" data-form-status></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .field-wrap {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 0.4s;
  }
  .field-wrap:focus-within {
    border-color: var(--color-neon);
  }
  .field {
    width: 100%;
    background: transparent;
    padding: 1rem 0;
    font-size: 1.05rem;
    color: var(--color-bone);
    outline: none;
  }
  .field::placeholder {
    color: var(--color-faint);
  }
  @media (max-width: 480px) {
    .field-wrap {
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 0.8rem;
    }
    .field {
      padding-top: 0.3rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copiado ✓';
      } catch {
        btn.textContent = 'No se pudo copiar';
      }
      setTimeout(() => (btn.textContent = 'Copiar'), 1800);
    });
  });

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !submit) return;
    const data = new FormData(form);
    if (data.get('botcheck')) return;

    const key = form.dataset.key;
    const nombre = String(data.get('nombre') ?? '');
    const negocio = String(data.get('negocio') ?? '');
    const contacto = String(data.get('contacto') ?? '');
    const mensaje = String(data.get('mensaje') ?? '');

    // Sin clave de Web3Forms: abre el cliente de mail con el mensaje armado.
    if (!key) {
      const body = `Nombre: ${nombre}\nNegocio: ${negocio}\nContacto: ${contacto}\n\n${mensaje}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
        `Consulta web${negocio ? ` - ${negocio}` : ''}`,
      )}&body=${encodeURIComponent(body)}`;
      return;
    }

    submit.disabled = true;
    status.className = 'text-sm text-dim';
    status.textContent = 'Enviando…';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `Nueva consulta web${negocio ? ` - ${negocio}` : ''}`,
          from_name: 'Portfolio web',
          nombre,
          negocio,
          contacto,
          mensaje,
        }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      status.className = 'text-sm text-bone';
      status.textContent = 'Recibido. Te respondo a la brevedad.';
    } catch {
      status.className = 'text-sm text-neon';
      status.textContent = 'No se pudo enviar. Escribime por WhatsApp.';
    } finally {
      submit.disabled = false;
    }
  });
</script>
