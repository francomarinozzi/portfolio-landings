---
import { site, whatsappUrl } from '../data/site';

const benefits = [
  {
    title: 'Te encuentran',
    text: 'Cuando alguien busca lo que vendés en tu zona, aparecés vos. Sin web, aparece la competencia.',
  },
  {
    title: 'Das confianza',
    text: 'Mucha gente te busca antes de comprarte. Un sitio propio dice "esto es serio".',
  },
  {
    title: 'Es tuyo',
    text: 'No dependés del algoritmo de Instagram ni le pagás comisión a un marketplace por cada venta.',
  },
  {
    title: 'Todo en un link',
    text: 'Para la bio, el estado de WhatsApp, el cartel del local o la tarjeta.',
  },
];

// Tabla comparativa: true = sí, false = no, string = texto
const columns = ['Agencia', 'Hacerlo vos', 'Conmigo'];
const rows: { k: string; v: (string | boolean)[] }[] = [
  { k: 'Precio', v: ['Alto', 'Cuota mensual', 'Accesible'] },
  { k: 'Diseño a medida', v: [true, false, true] },
  { k: 'Hablás con quien la hace', v: [false, false, true] },
  { k: 'Tiempo que te lleva a vos', v: ['Poco', 'Mucho', 'Poco'] },
  { k: 'Ves una maqueta antes de pagar', v: [false, false, true] },
];
---

<section id="por-que" class="scroll-mt-16 bg-night-2 py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid gap-10 lg:grid-cols-[14rem_1fr]">
      <p class="label" data-reveal>Por qué una web</p>
      <h2 class="display text-[clamp(2.6rem,6.5vw,5.6rem)]" data-split>
        Si no te encuentran en Google, <span class="text-dim">para muchos no existís.</span>
      </h2>
    </div>

    <!-- Beneficios: filas con número -->
    <ol class="mt-20 lg:ml-[calc(14rem+2.5rem)]">
      {
        benefits.map((b) => (
          <li
            class="group rule grid gap-2 border-t py-7 transition-colors duration-500 md:grid-cols-[1fr_1.3fr] md:gap-6 md:py-9"
            data-reveal
          >
            <h3 class="text-2xl font-medium tracking-tight transition-transform duration-500 group-hover:translate-x-2 md:text-3xl">
              {b.title}
            </h3>
            <p class="leading-relaxed text-dim">{b.text}</p>
          </li>
        ))
      }
    </ol>

    <!-- Por qué conmigo -->
    <div class="mt-36 grid gap-10 lg:grid-cols-[14rem_1fr]">
      <p class="label" data-reveal>Y por qué conmigo</p>
      <div class="min-w-0">
        <h3 class="display text-[clamp(2.2rem,5vw,4.2rem)]" data-split>
          Lo mejor de una agencia, <span class="text-dim">al precio de hacerlo vos.</span>
        </h3>

        <div class="mt-14 overflow-x-auto" data-reveal>
          <table class="w-full border-collapse text-left text-sm sm:text-base">
            <thead>
              <tr>
                <th class="w-[34%] pb-4"><span class="sr-only">Comparación</span></th>
                {
                  columns.map((c, i) => (
                    <th
                      class:list={[
                        'label pr-3 pb-4 align-bottom font-normal sm:pr-4',
                        i === columns.length - 1 && '!text-neon',
                      ]}
                    >
                      {c}
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr class="rule border-t">
                    <th class="py-4 pr-3 font-normal text-dim sm:py-5 sm:pr-4">{r.k}</th>
                    {r.v.map((cell, i) => {
                      const mine = i === r.v.length - 1;
                      return (
                        <td class:list={['py-4 pr-3 align-top sm:py-5 sm:pr-4', mine ? 'font-medium text-bone' : 'text-dim']}>
                          {cell === true ? (
                            <span class:list={[mine ? 'text-neon' : 'text-bone']}>Sí</span>
                          ) : cell === false ? (
                            <span class="text-faint">No</span>
                          ) : (
                            cell
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="rule mt-14 flex flex-wrap items-end justify-between gap-6 border-t pt-8" data-reveal>
          <div>
            <p class="label">Precio</p>
            <p class="mt-2 text-3xl font-medium tracking-tight">{site.price ?? 'A medida de tu negocio'}</p>
          </div>
          <a
            href={whatsappUrl('¡Hola Franco! Quería consultarte el precio de una página web.')}
            target="_blank"
            rel="noopener"
            class="btn btn-line"
            data-magnetic
          >
            Pedir presupuesto ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
