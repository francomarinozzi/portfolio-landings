---
import { site, whatsappUrl } from '../data/site';

const links = [
  { href: '#quien-soy', label: 'Quién soy' },
  { href: '#por-que', label: 'Por qué una web' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 transition-[background,border-color] duration-500" data-nav>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 md:px-8" aria-label="Principal">
    <a href="#inicio" class="text-[0.95rem] font-semibold tracking-tight">
      {site.name}
    </a>

    <ul class="hidden items-center gap-7 text-sm text-dim lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-nav-link class="ulink transition-colors hover:text-bone">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-5">
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 text-sm font-medium text-neon sm:inline-flex"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-neon opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-neon"></span>
        </span>
        <span class="ulink">Hablemos ↗</span>
      </a>
      <button
        type="button"
        class="label !text-bone lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        data-menu-btn
      >
        <span data-menu-label>Menú</span>
      </button>
    </div>
  </nav>

  <div
    class="invisible fixed inset-0 top-16 bg-night opacity-0 transition-opacity duration-300 lg:hidden"
    data-menu
  >
    <ul class="flex flex-col px-5 pt-6">
      {
        links.map((l) => (
          <li class="rule border-b">
            <a href={l.href} class="block py-5 text-4xl font-medium tracking-tight" data-menu-link>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={whatsappUrl()} target="_blank" rel="noopener" class="btn btn-neon mx-5 mt-8">Escribime por WhatsApp ↗</a>
  </div>
</header>
