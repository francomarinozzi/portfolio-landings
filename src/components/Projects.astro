---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { whatsappUrl } from '../data/site';
---

<section id="proyectos" class="mx-auto max-w-7xl scroll-mt-16 px-5 py-28 md:px-8 md:py-40">
  <div class="grid gap-10 lg:grid-cols-[14rem_1fr]">
    <p class="label" data-reveal>Proyectos</p>
    <h2 class="display text-[clamp(2.6rem,6.5vw,5.6rem)]" data-split>
      Trabajo <span class="text-dim">reciente.</span>
    </h2>
  </div>

  <div class="mt-20 flex flex-col gap-28">
    {
      projects.map((p) => (
        <article>
          <div class="rule grid items-baseline gap-4 border-t pt-6 md:grid-cols-[1fr_auto]" data-reveal>
            <h3 class="text-[clamp(2.4rem,5vw,4rem)] leading-none font-medium tracking-[-0.04em]">{p.name}</h3>
            <p class="label">{p.category}</p>
          </div>

          <div class="mt-8 overflow-hidden rounded-xl bg-night-2" data-clip-reveal>
            <div class="relative aspect-[16/10] md:aspect-[16/9]" data-slides data-parallax-img>
              {p.images.map((img, j) => (
                <Image
                  src={img}
                  alt={`${p.name}: captura ${j + 1} del sitio`}
                  widths={[700, 1100, 1600]}
                  sizes="(min-width: 1280px) 1216px, 94vw"
                  class:list={[
                    'absolute inset-0 size-full object-cover object-top transition-opacity duration-1000',
                    j > 0 && 'opacity-0',
                  ]}
                  data-slide
                />
              ))}
            </div>
          </div>

          <div class="mt-10 grid gap-10 md:grid-cols-2">
            <p class="max-w-md text-lg leading-relaxed text-dim" data-reveal>
              {p.summary}
            </p>
            <div data-reveal>
              <p class="label">Qué incluye</p>
              <ul class="mt-3">
                {p.features.map((f) => (
                  <li class="rule border-b py-2.5">{f}</li>
                ))}
              </ul>
              <p class="label mt-6">Hecho con</p>
              <p class="mt-2 font-mono text-sm text-dim">{p.stack.join(' · ')}</p>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="btn btn-line mt-8">
                  Visitar sitio ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }

    <a
      href={whatsappUrl('¡Hola Franco! Me gustaría que el próximo proyecto sea mi negocio.')}
      target="_blank"
      rel="noopener"
      class="group rule grid items-baseline gap-4 border-y py-10 md:grid-cols-[1fr_auto]"
      data-reveal
    >
      <span
        class="text-[clamp(2.4rem,5vw,4rem)] leading-none font-medium tracking-[-0.04em] text-faint transition-colors duration-500 group-hover:text-bone"
      >
        Tu negocio<span class="text-neon">?</span>
      </span>
      <span class="label transition-colors group-hover:!text-neon">Empecemos ↗</span>
    </a>
  </div>
</section>
